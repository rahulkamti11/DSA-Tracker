# Local Development:
# Leave as /api because Vite dev proxy (in vite.config.js) forwards /api requests to http://localhost:8787
VITE_API_URL=/api

# Production (Cloudflare Pages):
# In Cloudflare Pages Dashboard -> Settings -> Environment Variables, set:
# VITE_API_URL=https://dsa-tracker-api.<your-cloudflare-subdomain>.workers.dev/api
